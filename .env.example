# Copia este archivo a .env.local y rellena los valores.
# Los encuentras en Supabase → Project Settings → API.
#
# La clave "anon" es pública por diseño: quien protege los datos es
# la seguridad a nivel de fila (RLS) de supabase/schema.sql, no la clave.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON
